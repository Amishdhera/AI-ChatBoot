# ============================================
# BACKEND ENVIRONMENT VARIABLES (server-side only)
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to GitHub.
# ============================================

# Server
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (CORS)
CLIENT_ORIGIN=http://localhost:5173

# AI Provider (Google Gemini). Get a key at https://aistudio.google.com/apikey
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.0-flash

# Firebase Admin SDK credentials
# Generate via Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_service_account_email@your_project.iam.gserviceaccount.com
# Keep the \n escape sequences exactly as exported from the JSON key file, wrapped in quotes
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
